{
  "name": "netviet-hr-ios",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "dev": "node scripts/sync-public.mjs && npx wrangler dev",
    "build": "node scripts/sync-public.mjs",
    "attack": "node scripts/attack/run-all.mjs",
    "test": "node --check server.js worker.js src/api.js src/views/settings.js src/icons.js && npm run test:geofence && npm run test:attendance-period && npm run test:multi-proof && node tests/security-audit.mjs",
    "test:multi-proof": "node tests/multi-proof-wfh-ot.mjs",
    "test:employee-profile": "node tests/employee-profile-smoke.mjs",
    "test:attendance-period": "node tests/attendance-period.mjs",
    "test:geofence": "node tests/geofence.mjs",
    "test:ai-stream": "node tests/ai-stream-sse.mjs",
    "test:ai-security": "node tests/ai-p0-security-audit.mjs",
    "test:ai-agent": "node tests/ai-p1-agent-tools.mjs",
    "test:ai-actions": "node tests/ai-agent-actions.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File sync-to-deploy.ps1",
    "deploy:demo": "powershell -ExecutionPolicy Bypass -File sync-to-deploy.ps1",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File sync-to-deploy.ps1 -Config wrangler.prod.toml",
    "deploy:sync-only": "powershell -ExecutionPolicy Bypass -File sync-to-deploy.ps1 -NoDeploy",
    "backup": "powershell -ExecutionPolicy Bypass -File backup.ps1"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "capacitor-native-biometric": "^4.2.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "cropperjs": "^1.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "typescript": "^7.0.2"
  }
}
